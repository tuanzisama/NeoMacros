{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "NeoMacros",
  "description": "ECMAScript scripting for Minecraft clients (Fabric only).",
  "authors": ["tuanzi"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["ink.tuanzi.neomacros.fabric.NeoMacrosFabric"],
    "modmenu": ["ink.tuanzi.neomacros.fabric.NeoMacrosModMenu"]
  },
  "mixins": ["neomacros.mixins.json"],
  "depends": {
    "fabricloader": ">=${loader_min}",
    "fabric-api": "*",
    "minecraft": "${mc_range}",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*",
    "cloth-config2": "*"
  }
}
